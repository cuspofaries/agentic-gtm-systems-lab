# The CLI does not read this file. Export the variables you need in your shell.
# Full list of settings: docs/configuration.md

# Agentic mode only (`gtm-lab demo --agentic`). Offline mode needs no key.
# ANTHROPIC_API_KEY=

# Where run state, the mock CRM and review artifacts go (default: ./.gtm-lab-state)
# GTM_LAB_STATE_DIR=./.gtm-lab-state
