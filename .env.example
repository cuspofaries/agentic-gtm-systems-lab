# Optional - only needed for `gtm-lab demo --agentic` (not for offline mode).
# Anthropic API key for the ambiguous-signal qualifier LLM step.
# ANTHROPIC_API_KEY=

# Override the state directory (default: ./.gtm-lab-state)
# GTM_LAB_STATE_DIR=./.gtm-lab-state

# Override the enrichment budget (USD, integer cents). Default: 500 (= $5.00)
# GTM_LAB_BUDGET_CENTS=500
